# ---------------------------------------------------------------------------
# Venus Chicken Centers — environment
# Rotate DATABASE_URL's password in the Neon console: it has been shared.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate your own:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

FLASK_DEBUG=1

# ---------------------------------------------------------------------------
# Networking — nothing is hardcoded, every port comes from here
# ---------------------------------------------------------------------------
# The port the app listens on. `python run.py` uses it directly; in Docker the
# container listens on it and APP_PORT below maps it to your machine.
# Free hosts (Render, Koyeb, Railway) inject their own PORT and it wins.
PORT=5000
HOST=127.0.0.1

# gunicorn sizing. Two workers fit a 512 MB free instance; raise on a real box.
WEB_CONCURRENCY=2
WEB_THREADS=4

# Idle auto-logout, in minutes
IDLE_ADMIN_MIN=2
IDLE_SUPERVISOR_MIN=10

# Set to 1 once you serve over HTTPS
COOKIE_SECURE=0

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Docker ---------------------------------------------------------------
# Port on YOUR machine that maps to the container's PORT above.
APP_PORT=8000
# Only used with the localdb / tools profiles
DB_PORT=5432
ADMINER_PORT=8080
# First-boot administrator (optional). Blank = create one manually with
#   docker compose exec web python manage.py create-admin
ADMIN_NAME=System Admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Only used with:  docker compose --profile localdb up
POSTGRES_USER=venus
POSTGRES_PASSWORD=change-this-too
POSTGRES_DB=venus
